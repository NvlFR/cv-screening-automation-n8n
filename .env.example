# =============================================================================
# CV Screening Automation - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cv_screening

# Alternative individual settings (optional, used if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cv_screening
DB_USER=postgres
DB_PASSWORD=postgres

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_CONNECT_TIMEOUT=5000

# =============================================================================
# AI PROVIDER SETTINGS
# =============================================================================
AI_PROVIDER=anthropic

# OPENAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60000

# ANTHROPIC API (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet
ANTHROPIC_BASE_URL=https://api.anthropic.com

# =============================================================================
# S3 / File Storage
# =============================================================================
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=cv-screening-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Encryption key for CV files (32 characters for AES-256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=your-32-char-encryption-key-here

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
NOTIFICATION_WEBHOOK_URL=http://localhost:5678/webhook/notification

# Email notifications
EMAIL_ENABLED=false
EMAIL_FROM=noreply@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Slack notifications
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#cv-screening

# Discord notifications
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
MAX_CONCURRENT_CV=50
MAX_QUEUE_SIZE=1000

# =============================================================================
# N8N API (for workflow import script)
# =============================================================================
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your-n8n-api-key-here