{
  "name": "Notification_Workflow",
  "nodes": [
    {
      "id": "n1-0001-4000-8000-000000000001",
      "name": "Webhook (Notification)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "notification",
        "responseMode": "lastNode",
        "options": {
          "rawBody": false
        }
      },
      "webhookId": "notification-webhook"
    },
    {
      "id": "n1-0002-4000-8000-000000000002",
      "name": "Parse Notification Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "jsCode": "// Parse Notification Payload\n// Requirements: 8.1\n\nconst { eventType, candidateId, payload } = $input.item(0).json;\n\nif (!eventType) {\n  throw new Error('eventType diperlukan');\n}\n\nreturn [{\n  json: {\n    eventType,\n    candidateId,\n    payload: payload || {},\n    receivedAt: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "n1-0003-4000-8000-000000000003",
      "name": "Route by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [750, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.eventType }}",
        "rules": {
          "rules": [
            {
              "value2": "SHORTLISTED",
              "operation": "equals"
            },
            {
              "value2": "POSSIBLE_DUPLICATE",
              "operation": "equals"
            },
            {
              "value2": "PARSING_INCOMPLETE",
              "operation": "equals"
            },
            {
              "value2": "NOTIFICATION_FAILED",
              "operation": "equals"
            }
          ]
        },
        "fallbackOutput": "default"
      }
    },
    {
      "id": "n1-0004-4000-8000-000000000004",
      "name": "Notify SHORTLISTED (Email)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 4,
      "position": [1050, 100],
      "parameters": {
        "subject": "={{ 'Kandidat Shortlisted: ' + $json.payload.candidateName + ' - ' + $json.payload.jobTitle }}",
        "text": "={{ $json.payload.score + '/100 - ' + $json.payload.recommendation }}",
        "to": "={{ $env.RECruiter_EMAIL || 'hr@example.com' }}"
      },
      "credentials": {
        "smtp": {
          "id": "smtp-credential",
          "name": "SMTP"
        }
      },
      "disabled": true
    },
    {
      "id": "n1-0005-4000-8000-000000000005",
      "name": "Notify SHORTLISTED (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 3,
      "position": [1050, 280],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channel": "={{ $env.SLACK_CHANNEL || '#cv-screening' }}",
        "text": "={{ '🎉 *Kandidat Shortlisted*\\nCandidate: ' + $json.payload.candidateName + '\\nPosition: ' + $json.payload.jobTitle + '\\nScore: ' + $json.payload.score + '/100\\nRecommendation: ' + $json.payload.recommendation }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-api-credential",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n1-0006-4000-8000-000000000006",
      "name": "Notify POSSIBLE_DUPLICATE (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 3,
      "position": [1050, 460],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channel": "={{ $env.SLACK_CHANNEL || '#cv-screening' }}",
        "text": "={{ '⚠️ *Kemungkinan Duplikat Terdeteksi*\\nRecord Baru: ' + $json.payload.newRecord.name + ' (' + $json.payload.newRecord.email + ')\\nExisting Record: ' + $json.payload.existingRecordId }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-api-credential",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n1-0007-4000-8000-000000000007",
      "name": "Notify POSSIBLE_DUPLICATE (Discord)",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1050, 620],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "webhook": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "text": "={{ '⚠️ Kemungkinan Duplikat Terdeteksi\\nRecord Baru: ' + $json.payload.newRecord.name + ' (' + $json.payload.newRecord.email + ')\\nExisting Record: ' + $json.payload.existingRecordId }}"
      }
    },
    {
      "id": "n1-0008-4000-8000-000000000008",
      "name": "Notify PARSING_INCOMPLETE (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 3,
      "position": [1050, 780],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channel": "={{ $env.SLACK_CHANNEL || '#cv-screening' }}",
        "text": "={{ '⚠️ *CV Parsing Tidak Lengkap*\\nFile: ' + $json.payload.filename + '\\nField yang hilang: ' + ($json.payload.missingFields && $json.payload.missingFields.join(', ')) }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-api-credential",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n1-0009-4000-8000-000000000009",
      "name": "Notify NOTIFICATION_FAILED (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 3,
      "position": [1050, 940],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channel": "={{ $env.SLACK_CHANNEL || '#cv-screening' }}",
        "text": "={{ '❌ *Gagal Mengirim Notifikasi*\\nEvent: ' + $json.payload.eventType + '\\nError: ' + $json.payload.error }}"
      },
      "credentials": {
        "slackApi": {
          "id": "slack-api-credential",
          "name": "Slack API"
        }
      }
    },
    {
      "id": "n1-0010-4000-8000-000000000010",
      "name": "Log Notification Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1300, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO notifications (event_type, candidate_id, channel, status, details, created_at) VALUES ($1, $2, $3, 'sent', $4::jsonb, NOW()) RETURNING id",
        "additionalFields": {
          "queryParams": "={{ $json.eventType }},{{ $json.candidateId }},{{ $json.channel || 'slack' }},{{ JSON.stringify($json.payload) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "postgres-credential",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "id": "n1-0011-4000-8000-000000000011",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1550, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'notification_sent', eventType: $json.eventType, sentAt: new Date().toISOString() }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
