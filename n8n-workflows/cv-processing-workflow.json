        1750,
        420
      ],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.jdMatchStatus }}",
        "rules": {
          "rules": [
            {
              "value2": "NO_JD_AVAILABLE",
              "operation": "equals"
            }
          ]
        },
        "fallbackOutput": "default"
      }
    },
    {
      "id": "cp-save-no-jd-001",
      "name": "Save NO_JD",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO candidate_records (name, email, status, job_id, source, created_at) VALUES ($1, $2, 'NO_JD_AVAILABLE', $3, $4, NOW()) RETURNING id",
        "additionalFields": {
          "queryParams": "={{ $json.name }},{{ $json.email }},{{ $json.job_id }},{{ $json.source }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "postgres-credential",
          "name": "PostgreSQL"
        }
      }
    },
