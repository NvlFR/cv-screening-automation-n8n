        "jsCode": "const { runSummaryGenerator } = require('/home/rny/work/2026/05-mei/cv-screening-automation-n8n/src/summary-generator/summary-wrapper');\nconst items = $input.all();\nreturn await runSummaryGenerator(items);"
      }
