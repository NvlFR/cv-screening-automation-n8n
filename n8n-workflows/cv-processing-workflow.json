      "name": "Scoring Engine Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        540
      ],
      "parameters": {
        "jsCode": "const { runScoringEngine } = require('/home/rny/work/2026/05-mei/cv-screening-automation-n8n/src/scoring-engine/scoring-wrapper');\nconst items = $input.all();\nreturn runScoringEngine(items);"
      }
    },
    {
      "id": "cp-summary-001",
      "name": "Summary Generator Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2250,
        540
      ],
