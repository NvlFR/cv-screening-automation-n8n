    {
      "id": "cp-shortlist-001",
      "name": "Shortlisting Engine Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2500,
        540
      ],
      "parameters": {
        "jsCode": "const { runShortlistingEngine } = require('/home/rny/work/2026/05-mei/cv-screening-automation-n8n/src/shortlisting-engine/shortlisting-engine');\nconst items = $input.all();\nreturn runShortlistingEngine(items);"
      }
    },
    {
      "id": "cp-save-final-001",
      "name": "Save Final Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        2750,
        540
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO candidate_records (name, email, phone, location, skills, experience_years, education, certifications, score, recommendation, summary, status, shortlist_reason, job_id, source, created_at) VALUES ($1, $2, $3, $4, $5::jsonb, $6, $7::jsonb, $8::jsonb, $9, $10, $11, $12, $13, $14, $15, NOW()) RETURNING id",
        "additionalFields": {
          "queryParams": "={{ $json.name }},{{ $json.email }},{{ $json.phone }},{{ $json.location }},{{ JSON.stringify($json.skills) }},{{ $json.experience_years }},{{ JSON.stringify($json.education) }},{{ JSON.stringify($json.certifications) }},{{ $json.score }},{{ $json.recommendation }},{{ $json.summary }},{{ $json.status }},{{ $json.shortlistReason }},{{ $json.job_id }},{{ $json.source }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "postgres-credential",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "id": "cp-notify-final-001",
      "name": "Notify Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        3000,
        540
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "shortlisted-condition",
              "leftValue": "={{ $json.status }}",
              "rightValue": "Shortlisted",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "cp-notify-shortlisted-001",
      "name": "Notify Shortlisted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        3250,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/notification",
        "sendBody": true,
        "jsonBody": "={\n  \"eventType\": \"SHORTLISTED\",\n  \"candidateId\": \"{{ $json.id }}\",\n  \"payload\": {\n    \"candidateName\": \"{{ $json.name }}\",\n    \"score\": {{ $json.score }},\n    \"recommendation\": \"{{ $json.recommendation }}\"\n  }\n}"
      }
    }
