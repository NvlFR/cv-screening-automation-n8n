{
  "name": "CV_Processing_Workflow",
  "nodes": [
    {
      "id": "cp-trigger-001",
      "name": "Queue Consumer",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "operation": "pop",
        "key": "cv_processing_queue",
        "tail": true
      },
      "credentials": {
        "redis": {
          "id": "redis-credential",
          "name": "Redis"
        }
      }
    },
    {
      "id": "cp-parser-001",
      "name": "CV Parser Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "const { runCVParser } = require('/home/rny/work/2026/05-mei/cv-screening-automation-n8n/src/cv-parser/cv-parser-wrapper');\nconst items = $input.all();\nreturn await runCVParser(items);"
      }
    },
    {
      "id": "cp-status-001",
      "name": "Check Parsing Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        750,
        300
      ],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.status }}",
        "rules": {
          "rules": [
            {
              "value2": "PARSING_INCOMPLETE",
              "operation": "equals"
            },
            {
              "value2": "PARSING_FAILED",
              "operation": "equals"
            }
          ]
        },
        "fallbackOutput": "default"
      }
    },
    {
      "id": "cp-save-incomplete-001",
      "name": "Save Incomplete/Failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1000,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO candidate_records (name, email, status, source, created_at) VALUES ($1, $2, $3, $4, NOW()) RETURNING id",
        "additionalFields": {
          "queryParams": "={{ $json.name || 'Unknown' }},{{ $json.email || null }},{{ $json.status }},{{ $json.source || 'unknown' }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "postgres-credential",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "id": "cp-notify-incomplete-001",
      "name": "Notify Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1250,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/notification",
        "sendBody": true,
        "jsonBody": "={\n  \"eventType\": \"{{ $json.status }}\",\n  \"candidateId\": \"{{ $json.id }}\",\n  \"payload\": {\n    \"filename\": \"{{ $json.filename }}\",\n    \"error\": \"{{ $json.error }}\"\n  }\n}"
      }
    },
    {
      "id": "cp-duplicate-001",
      "name": "Duplicate Detector Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "jsCode": "const { runDuplicateDetector } = require('/home/rny/work/2026/05-mei/cv-screening-automation-n8n/src/duplicate-detector/detector-wrapper');\nconst items = $input.all();\nreturn await runDuplicateDetector(items);"
      }
    },
    {
      "id": "cp-route-duplicate-001",
      "name": "Route Duplicate",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.duplicateStatus }}",
        "rules": {
          "rules": [
            {
              "value2": "DUPLICATE",
              "operation": "equals"
            },
            {
              "value2": "POSSIBLE_DUPLICATE",
              "operation": "equals"
            }
          ]
        },
        "fallbackOutput": "default"
      }
    },
    {
      "id": "cp-save-duplicate-001",
      "name": "Save Duplicate",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1500,
        180
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO candidate_records (name, email, status, duplicate_of, source, created_at) VALUES ($1, $2, $3, $4, $5, NOW()) RETURNING id",
        "additionalFields": {
          "queryParams": "={{ $json.name }},{{ $json.email }},{{ $json.duplicateStatus }},{{ $json.duplicateOf }},{{ $json.source }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "postgres-credential",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "id": "cp-notify-duplicate-001",
      "name": "Notify Duplicate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1750,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/notification",
        "sendBody": true,
        "jsonBody": "={\n  \"eventType\": \"{{ $json.duplicateStatus }}\",\n  \"candidateId\": \"{{ $json.id }}\",\n  \"payload\": {\n    \"existingRecordId\": \"{{ $json.duplicateOf }}\"\n  }\n}"
      }
    },
    {
      "id": "cp-matcher-001",
      "name": "JD Matcher Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        420
      ],
      "parameters": {
        "jsCode": "const { runJDMatcher } = require('/home/rny/work/2026/05-mei/cv-screening-automation-n8n/src/jd-matcher/matcher-wrapper');\nconst items = $input.all();\nreturn await runJDMatcher(items);"
